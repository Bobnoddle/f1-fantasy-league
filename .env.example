# One-time copy:  cp .env.example .env
# Self-hosted only. The hosted tier uses Railway-injected variables.

# ── Required everywhere ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://f1fantasy:change-me@localhost:5432/f1fantasy
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
SESSION_SECRET=generate-with-openssl-rand-hex-32
APP_URL=http://localhost:8080

# ── Self-host admin ─────────────────────────────────────────────────────────
# Your Discord user id. Only this account can open the admin panel.
ADMIN_DISCORD_ID=

# ── Hosted tier only ────────────────────────────────────────────────────────
# Absent in self-host. Its presence is what enables billing.
STRIPE_SECRET_KEY=
# Encrypts stored Discord webhook tokens. Required once you host for others.
TOKEN_ENCRYPTION_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
SEED_STRIPE_PRICES=false
LOG_LEVEL=INFO
POST_RACE_WINDOW_HOURS=36
FETCH_TIMEOUT_SECS=30
FETCH_RETRIES=3
# Needs to match your Railway cron job name so the lock is shared.
CRON_LOCK_NAME=cron:score
