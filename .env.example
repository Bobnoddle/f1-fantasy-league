# Copy to .env for local development:  cp .env.example .env
#
# SESSION_SECRET signs the session cookie. Rotating it signs everyone out.
# Generate one with:  openssl rand -hex 32
#
# Everything else here is optional.

# ── Required ─────────────────────────────────────────────────────────────────
SESSION_SECRET=generate-with-openssl-rand-hex-32

# ── Database ─────────────────────────────────────────────────────────────────
# For `docker compose`, the services get their own DATABASE_URL from
# docker-compose.yml, pointing at the db service by its compose hostname. Set
# this only to run the CLI against a database directly:
#
#   postgresql+asyncpg://user:pass@127.0.0.1:5432/f1
#
# POSTGRES_PASSWORD is the password for the Postgres that `docker compose`
# starts. It has a default there; set it explicitly for anything you keep.
POSTGRES_PASSWORD=f1fantasy
DATABASE_URL=postgresql+asyncpg://f1fantasy:f1fantasy@db:5432/f1fantasy

APP_URL=http://localhost:8080

# ── Discord, entirely optional ───────────────────────────────────────────────
# Leave both empty and the app runs with no Discord integration at all: no
# OAuth button, and announcements go nowhere. Every league is still playable.
#
# There is no admin Discord id to configure. Whoever creates a league is its
# admin, and only they can open its admin panel.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Behaviour ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# How long after a race finishes to keep scoring it, in hours.
POST_RACE_WINDOW_HOURS=36

# Upstream request handling.
FETCH_TIMEOUT_SECS=30
FETCH_RETRIES=3

# Must match the scheduler's job name so two runs cannot overlap.
CRON_LOCK_NAME=cron:score